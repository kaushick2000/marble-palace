# Postgres connection used by the FastAPI app (async driver)
DATABASE_URL=postgresql+asyncpg://marble:marble@db:5432/marble_palace

# Session auth
SESSION_TOKEN_EXPIRE_MINUTES=480

# Kept for backward-compat / future JWT-based endpoints (unused by session auth)
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Shared secret required to call the admin-user seed/setup flow
ADMIN_SETUP_SECRET=change-me
